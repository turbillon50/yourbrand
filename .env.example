# ============================================================================
# WHITE-LABEL ENV TEMPLATE
# ============================================================================
# Copia este archivo como .env y rellena los valores. Nunca subas secretos.

# ─── WHITE-LABEL: Identidad de marca ─────────────────────────────────────────
# Todos estos valores se usan en frontend y/o backend para personalizar
# la aplicacion con tu marca.

# Nombre visual de la marca (ej. "Castores")
BRAND_NAME=YourBrand
# Nombre completo / legal (ej. "Castores Estructuras y Construcciones")
BRAND_FULL_NAME=YourBrand Company
# Slug en minúsculas, sin espacios — se usa como prefijo en localStorage y cookies
BRAND_SLUG=yourbrand
# Dominio de produccion (sin https://) (ej. "castores.info")
BRAND_DOMAIN=yourbrand.com
# Email de soporte para Web Push (VAPID subject)
BRAND_SUPPORT_EMAIL=soporte@yourbrand.com

# Equivalentes en frontend (Vite):
VITE_BRAND_NAME=YourBrand
VITE_BRAND_SHORT_NAME=YourBrand
VITE_BRAND_FULL_NAME=YourBrand Company
VITE_BRAND_SLUG=yourbrand
VITE_BRAND_DESCRIPTION=Work management system
VITE_BRAND_LOGO_PATH=/brand-logo.jpeg
VITE_BRAND_THEME_COLOR=#0A0A0A
VITE_BRAND_PRIMARY_COLOR=#F59E0B

# ─── Base de datos (API) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# ─── Sesion servidor (API) ───────────────────────────────────────────────────
# Genera un valor largo y aleatorio para production.
SESSION_SECRET=replace_with_long_random_secret

# ─── Clerk Auth ──────────────────────────────────────────────────────────────
# Server (API):
CLERK_SECRET_KEY=sk_test_replace_me
# Frase segura para activar administrador general inicial (solo server-side).
# Cambia esto por un valor secreto propio de tu marca.
ADMIN_ACCESS_PHRASE=replace_with_your_admin_phrase
# Client (Web Vite):
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Opcional si usas proxy de Clerk en el mismo dominio:
VITE_CLERK_PROXY_URL=

# ─── API runtime ─────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ─── Web runtime (Vite) ──────────────────────────────────────────────────────
# En produccion suele ser "/" si se publica en raiz.
BASE_PATH=/
# Opcional para deploy en dos proyectos Vercel (web + api).
VITE_API_BASE_URL=

# ─── Invitaciones / redirecciones ────────────────────────────────────────────
# URL publica del frontend, sin slash final. Ejemplo:
# https://demo.yourbrand.com
FRONTEND_PUBLIC_URL=

# ─── CORS adicional (opcional) ───────────────────────────────────────────────
# Lista separada por coma de origenes adicionales permitidos por la API.
# FRONTEND_PUBLIC_URL ya se considera permitido automaticamente.
ALLOWED_ORIGINS=

# ─── Email transaccional (opcional para demo) ────────────────────────────────
RESEND_API_KEY=

# ─── Web Push VAPID (opcional para notificaciones push) ──────────────────────
# Genera un par de llaves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Si no se define, se usara BRAND_SUPPORT_EMAIL
VAPID_SUBJECT=
